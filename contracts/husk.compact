pragma language_version 0.23;

import CompactStandardLibrary;

// Public evidence that a payment was screened and cleared. Each entry is a
// hiding commitment built in pay(); no amount, no party, and no linkable
// identifier is recoverable from the entry itself.
export ledger screened: Set<Bytes<32>>;

// --- Private state (witness-held, supplied by the off-chain driver) ---

// Compliance screening oracle backed by the real dilisense API
// (https://developers.dilisense.com/, GET /v1/checkIndividual), implemented
// off-chain by the driver (test/src/screening.ts in the test project). The
// witness receives the recipient's ZswapCoinPublicKey, the PAYER-SUPPLIED
// claimed name for that recipient, and the payment amount, and returns
// whether the payment may proceed. Fail-closed: any provider error is a
// screening failure, never a silent skip.
//
// `recipientName` is an Opaque<"string">: a client-held, arbitrary-length
// string the CIRCUIT ITSELF CANNOT READ. It is verified by compilation with
// the real toolchain (compact 0.5.2 / compiler 0.31.1 / language 0.23.0) to:
//   - be accepted as a circuit parameter type,
//   - keep the ledger-touching pay() circuit provable ("proof": true with
//     full zkir + prover/verifier keys generated),
//   - consume ZERO circuit inputs in the zkir — the name is forwarded by the
//     generated runtime code into the witness call ONLY. It can never reach
//     the ledger: any disclose/commit/use of it in circuit code is a compile
//     error, and the compiled zkir below contains no trace of it.
//
// The recipient is identified by their ZswapCoinPublicKey, the only recipient
// identity a shielded payment exposes; mapping that key to the off-chain
// identity actually screened (the claimed name) is the driver's responsibility.
witness screeningPassed(recipient: ZswapCoinPublicKey, recipientName: Opaque<"string">, amount: Uint<128>): Boolean;

// Fresh per-payment randomness used as the hiding salt of the screened
// commitment. MUST be uniformly random and never reused: it is what makes the
// Set entry unlinkable across payments and its preimage unguessable.
witness screeningNonce(): Bytes<32>;

export circuit pay(
  recipient: ZswapCoinPublicKey,
  coin: ShieldedCoinInfo,
  amount: Uint<128>,
  // Payer-supplied claimed name of the recipient. Opaque<"string">: the
  // circuit cannot read it — the generated runtime forwards it into the
  // screeningPassed witness call and nowhere else. It is NEVER disclosed,
  // NEVER committed, and NEVER written to the ledger in any form.
  recipientName: Opaque<"string">
): [] {
  // 1. Screening gate. A failure here reverts the whole transaction: no coin
  //    spend, no Set write, no "rejected" trace in public state — the only
  //    visible effect is that the proof does not verify. The claimed name is
  //    consumed here and nowhere else.
  assert(screeningPassed(recipient, recipientName, amount), "husk: recipient failed screening");

  // EXACT-VALUE GATE (no partial payments, no change, ever). Replaces the
  // old "amount <= coin.value" assert and the old change-handling if/else
  // block entirely: change cannot occur by construction, so there is no
  // change-coin custody to manage.
  assert(amount == coin.value, "husk: partial payment not supported, amount must equal coin value");

  // 2. Move the value via the verified receiveShielded +
  //    sendImmediateShielded pattern (see contracts/relay.compact, proven on
  //    the real devnet): take momentary custody of the fresh,
  //    contract-addressed output for this transaction, then forward its full
  //    value to `recipient` (shielded key, i.e. the left side of the
  //    recipient Either) in the same call. Nothing persists once the
  //    transaction completes. disclose() is the compiler's permission gate
  //    for private values entering coin primitives (same idiom as the
  //    official coin test contracts).
  receiveShielded(disclose(coin));
  const result = sendImmediateShielded(
    disclose(coin),
    left<ZswapCoinPublicKey, ContractAddress>(disclose(recipient)),
    disclose(amount));

  // 2a. Safety net (not expected to ever trigger given the exact-value gate
  //     above): if this ever fires, the amount==coin.value assumption was
  //     wrong somewhere, and that is a real bug to surface, not silently
  //     ignore.
  assert(result.change.is_some == false, "husk: unexpected change coin");

  // 3. Public proof of screening: a HIDING commitment over the payment
  //    context. persistentCommit (not persistentHash — a bare hash of a
  //    guessable preimage binds but does not hide) binds
  //    [domain tag, recipient, amount, sent coin nonce] under the fresh
  //    witness nonce as secret salt, so the entry:
  //      - proves this exact payment shape was screened and cleared,
  //      - is unique per payment (fresh nonce; a repeated identical payment
  //        still produces a distinct entry),
  //      - reveals neither amount nor recipient (they are committed under a
  //        secret salt, not hashed in the clear).
  //    Only the commitment itself is disclosed into the ledger — never the
  //    nonce, the recipient, or the amount via this path.
  const commitment = persistentCommit<Vector<4, Bytes<32>>>(
    [pad(32, "husk:screened:payment:v1"), recipient.bytes, amount as Bytes<32>, result.sent.nonce],
    screeningNonce());
  screened.insert(disclose(commitment));
}

constructor() {
}